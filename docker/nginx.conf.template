server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;

    # Keep redirects relative so Docker-published ports are preserved.
    absolute_redirect off;

    # Gzip compression for better performance
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml application/xml+rss;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Serve Elettra application
    location = /elettra {
        return 301 /elettra/;
    }

    # Runtime frontend settings must never be cached across deployments.
    location = /elettra/runtime-config.json {
        alias /usr/share/nginx/html/elettra/runtime-config.json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location /elettra/ {
        alias /usr/share/nginx/html/elettra/;
        try_files ${ESC}uri ${ESC}uri/ /elettra/index.html;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)${ESC} {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Redirect root to /elettra/
    location = / {
        return 301 /elettra/;
    }

    # Proxy authentication requests to backend
    location /auth {
        proxy_pass ${API_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${ESC}http_host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Proxy API requests to backend
    location /api {
        proxy_pass ${API_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${ESC}http_host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Health check endpoint for container orchestration
    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
