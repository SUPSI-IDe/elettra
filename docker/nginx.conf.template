limit_req_zone ${ESC}binary_remote_addr zone=network_preview_per_ip:10m rate=1r/s;

proxy_cache_path /var/cache/nginx/network-preview
    levels=1:2
    keys_zone=network_preview_cache:10m
    max_size=64m
    inactive=1h
    use_temp_path=off;

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;

    # Keep redirects relative so Docker-published ports are preserved.
    absolute_redirect off;

    # Gzip compression for better performance
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml application/xml+rss;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Serve Elettra application
    location = /elettra {
        return 301 /elettra/;
    }

    # Runtime frontend settings must never be cached across deployments.
    location = /elettra/runtime-config.json {
        alias /usr/share/nginx/html/elettra/runtime-config.json;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location /elettra/ {
        alias /usr/share/nginx/html/elettra/;
        try_files ${ESC}uri ${ESC}uri/ /elettra/index.html;
        # Revalidate the HTML entry point after a deployment. Hashed assets
        # below remain immutable and can still be cached for one year.
        add_header Cache-Control "no-cache, must-revalidate" always;
        # nginx inherits add_header directives only when none are defined here.
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)${ESC} {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Redirect root to /elettra/
    location = / {
        return 301 /elettra/;
    }

    # Proxy authentication requests to backend
    location /auth {
        proxy_pass ${API_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${ESC}http_host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Protect and share the anonymous agency-network previews. The cache key
    # deliberately excludes query strings because this endpoint has no query
    # parameters; random arguments must not bypass the shared cache.
    location ~ "^/api/v1/agency/agencies/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/network-preview${ESC}" {
        limit_req zone=network_preview_per_ip burst=10 nodelay;
        limit_req_status 429;

        proxy_cache network_preview_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_key ${ESC}uri;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_lock_age 10s;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_valid 200 1h;
        proxy_cache_valid 404 1m;

        proxy_pass ${API_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${ESC}http_host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        add_header X-Elettra-Cache ${ESC}upstream_cache_status always;
        # Defining a location-specific header disables add_header inheritance.
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    # Proxy all other API requests to backend without shared caching.
    location /api {
        proxy_pass ${API_BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host ${ESC}http_host;
        proxy_set_header X-Real-IP ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${ESC}scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Health check endpoint for container orchestration
    location /health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
