# Immutable GHCR image tag or digest produced by the candidate workflow.
ELETTRA_FRONTEND_IMAGE=ghcr.io/supsi-ide/elettra:staging

# Bind staging to loopback by default. Use 0.0.0.0 only when remote access is required.
ELETTRA_STAGING_BIND_ADDRESS=127.0.0.1
ELETTRA_STAGING_PORT=55558

# Backend running on this Docker host.
API_BACKEND_URL=http://host.docker.internal:8002
CARTO_API_KEY=your-domain-restricted-browser-key
